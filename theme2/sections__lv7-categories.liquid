{% render 'lv7-head' %}
<div class="lv7">
<section class="s">
  <div class="wrap">
    <div class="s-head"><div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div></div>
    <div class="cats" style="grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign url = block.settings.link | default: c.url | default: '#'
          assign count = c.products_count
          assign from = ''
          if count > 0
            assign from = c.products | map: 'price' | sort | first | money
          endif
          assign meta = block.settings.meta
          if meta == blank
            if count > 0
              assign meta = count | append: ' ' | append: block.settings.unit | append: ' · from [from]'
            else
              assign meta = 'Coming soon'
            endif
          endif
          if count == 0 and meta contains '[from]'
            assign meta = 'Coming soon'
          endif
          assign meta = meta | replace: '[from]', from | replace: '[count]', count
        -%}
        <a class="cat amz" href="{{ url }}" style="background: {{ block.settings.bg }}" {{ block.shopify_attributes }}>
          <div class="ph">{%- render 'lv7-img', image: block.settings.image, fallback: block.settings.image_fallback, alt: block.settings.title, width: 800 -%}</div>
          <h3>{{ block.settings.title }}</h3><span class="meta">{{ meta }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Limmys category tiles",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kit for every stage of learning to swim"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Tiles per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Count and 'from' price come from this collection."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional, defaults to the collection)"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Count word",
          "default": "colours",
          "info": "e.g. colours, prints, designs"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Custom line (optional)",
          "info": "Use [count] and [from] for live values, e.g. Kids and grown-ups · from [from]"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background colour",
          "default": "#e4eefa"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_fallback",
          "label": "Built-in image (used until you pick one)",
          "info": "Theme file name without the lv7- prefix. Leave as is."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Limmys category tiles"
    }
  ]
}
{% endschema %}
