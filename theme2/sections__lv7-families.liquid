{% render 'lv7-head' %}
<div class="lv7">
<section class="s">
  <div class="wrap">
    <div class="s-head"><div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div></div>
    <div class="mosaic">
      {%- for block in section.blocks -%}
        <a class="tile{% if forloop.first %} big{% endif %}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {%- render 'lv7-img', image: block.settings.image, fallback: block.settings.image_fallback, alt: block.settings.alt, width: 1000 -%}
          {%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Limmys photo strip",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "#limmys"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real families, real swims"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Tag @limmys.official to be featured."
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "image_fallback",
          "label": "Built-in image (used until you pick one)",
          "info": "Theme file name without the lv7- prefix. Leave as is."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Photo description"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Limmys photo strip"
    }
  ]
}
{% endschema %}
