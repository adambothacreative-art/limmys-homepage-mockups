{% render 'lv7-head' %}
<div class="lv7">
<section class="hero6">
  <div class="h6-photo">
    {%- render 'lv7-img', image: section.settings.image, fallback: section.settings.image_fallback, alt: section.settings.image_alt, width: 2400, loading: 'eager' -%}
    {%- if section.settings.show_badge -%}<div class="badge-r"><span>{{ section.settings.badge_line_1 | newline_to_br }}<small>{{ section.settings.badge_line_2 }}</small></span></div>{%- endif -%}
  </div>
  <div class="h6-panel">
    <svg class="gfx palm"><use href="#lv7-palm"/></svg>
    <svg class="h6-wave-m" viewBox="0 0 400 40" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 22 C60 2 120 38 200 18 S330 4 400 20 V40 H0Z" fill="#f0f9fa"/>
      <path d="M0 22 C60 2 120 38 200 18 S330 4 400 20" fill="none" stroke="#ffffff" stroke-width="6" vector-effect="non-scaling-stroke"/>
      <path d="M0 15 C60 -5 120 31 200 11 S330 -3 400 13" fill="none" stroke="#1bbfa2" stroke-width="3" vector-effect="non-scaling-stroke"/>
    </svg>
    <div class="h6-copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="sub">{{ section.settings.text }}</p>{%- endif -%}
      <div class="ctas">
        {%- if section.settings.button_1 != blank -%}<a class="btn solid" href="{{ section.settings.button_1_link | default: '#' }}">{{ section.settings.button_1 }}</a>{%- endif -%}
        {%- if section.settings.button_2 != blank -%}<a class="btn ghost" href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2 }}</a>{%- endif -%}
      </div>
      <div class="trust">
        {%- if section.settings.trust_1 != blank -%}<span>{% if section.settings.trust_1_stars %}<span class="stars">★★★★★</span> {% endif %}{{ section.settings.trust_1 }}</span>{%- endif -%}
        {%- if section.settings.trust_2 != blank -%}<span>{{ section.settings.trust_2 }}</span>{%- endif -%}
        {%- if section.settings.trust_3 != blank -%}<span>{{ section.settings.trust_3 }}</span>{%- endif -%}
      </div>
    </div>
  </div>
  <svg class="h6-lines" viewBox="0 0 84 480" preserveAspectRatio="none" aria-hidden="true">
    <path d="M25 0C63 70 10 140 38 220S67 340 29 400S22 460 34 480" fill="none" stroke="#ffffff" stroke-width="5" vector-effect="non-scaling-stroke"/>
    <path d="M36 0C74 70 21 140 49 220S78 340 40 400S33 460 45 480" fill="none" stroke="#1bbfa2" stroke-width="3" vector-effect="non-scaling-stroke"/>
  </svg>
</section>
</div>

{% schema %}
{
  "name": "Limmys hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "image_fallback",
      "label": "Built-in image (used until you pick one)",
      "info": "Theme file name without the lv7- prefix. Leave as is."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description (alt text)",
      "default": "Four children lying on a pebble beach by the sea in Limmys swim vests and arm bands"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Swim aids and accessories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything they need to learn to swim"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Swim vests, arm bands, caps and goggles for kids who are learning. Swim caps for the grown-ups swimming with them."
    },
    {
      "type": "text",
      "id": "button_1",
      "label": "Button 1",
      "default": "Shop swim aids"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2",
      "label": "Button 2",
      "default": "Shop accessories"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Trust line"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Item 1",
      "default": "4.8 from 31,067 reviews"
    },
    {
      "type": "checkbox",
      "id": "trust_1_stars",
      "label": "Show stars before item 1",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Item 2",
      "default": "Award-winning"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Item 3",
      "default": "30-day returns"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show round badge",
      "default": true
    },
    {
      "type": "textarea",
      "id": "badge_line_1",
      "label": "Badge text",
      "default": "Award-\nwinning"
    },
    {
      "type": "text",
      "id": "badge_line_2",
      "label": "Badge small text",
      "default": "swim aids"
    }
  ],
  "presets": [
    {
      "name": "Limmys hero"
    }
  ]
}
{% endschema %}
