{% render 'lv7-head' %}
<div class="lv7" data-lv7="club">
<section class="s" style="padding-top:0">
  <div class="wrap">
    <div class="club">
      <div class="in">
        <svg class="gfx palm"><use href="#lv7-palm"/></svg>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:var(--teal)">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <form data-club novalidate>
          <input type="email" placeholder="Email" aria-label="Email" autocomplete="email">
          {%- if section.settings.show_age -%}
          <select aria-label="Child's age (optional)"><option value="">Child's age (optional)</option><option>Under 2</option><option>2 to 3</option><option>3 to 6</option><option>6 to 9</option><option>9+</option></select>
          {%- endif -%}
          <button class="btn" type="submit">{{ section.settings.button }}</button>
          <p class="fine">{{ section.settings.small_print }}</p>
        </form>
      </div>
      <div class="photo">{%- render 'lv7-img', image: section.settings.image, fallback: section.settings.image_fallback, alt: section.settings.image_alt, width: 1200 -%}</div>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Limmys swim club sign-up",
  "settings": [
    {
      "type": "paragraph",
      "content": "Test version: the form is not connected to Klaviyo yet."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Limmys Swim Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Limmys Swim Club"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Get 10% off your first order, first access to new launches and learn-to-swim tips for your child's stage."
    },
    {
      "type": "checkbox",
      "id": "show_age",
      "label": "Ask for child's age",
      "default": true
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Join the club"
    },
    {
      "type": "text",
      "id": "small_print",
      "label": "Small print",
      "default": "Unsubscribe at any time."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "image_fallback",
      "label": "Built-in image (used until you pick one)",
      "info": "Theme file name without the lv7- prefix. Leave as is."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description",
      "default": "Two children in swim vests walking into the sea"
    }
  ],
  "presets": [
    {
      "name": "Limmys swim club sign-up"
    }
  ]
}
{% endschema %}
