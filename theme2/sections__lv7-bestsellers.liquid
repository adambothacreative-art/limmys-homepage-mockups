{% render 'lv7-head' %}
<div class="lv7" data-lv7="cards">
<section class="s">
  <div class="wrap">
    <div class="s-head">
      <div>{%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}<h2>{{ section.settings.heading }}</h2></div>
      {%- if section.settings.link_label != blank -%}<a class="link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="grid">
      {%- for block in section.blocks -%}
        {%- assign plist = block.settings.products -%}
        {%- assign p0 = plist.first -%}
        {%- if plist == blank or plist.size == 0 -%}
          {%- if request.design_mode -%}<article class="card soon" {{ block.shopify_attributes }}><div class="ph"></div><div class="body"><h3>{{ block.settings.title }}</h3><p class="feat">Pick products for this card.</p></div></article>{%- endif -%}
          {%- continue -%}
        {%- endif -%}
        <article class="card" data-card {{ block.shopify_attributes }}>
          <script type="application/json" data-products>[{%- for p in plist -%}{% render 'lv7-product-json', p: p, swatches: section.settings.swatches %}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
          <div class="ph" data-ph style="background: {{ block.settings.tint }}">
                        {%- if block.settings.badge != blank -%}<span class="badge{% if block.settings.badge_dark %} dark{% endif %}">{{ block.settings.badge }}</span>{%- endif -%}
            <img class="p prod" data-pack src="" alt="{{ block.settings.title | escape }}">
            {%- if block.settings.image != blank or block.settings.image_fallback != blank -%}
              {%- render 'lv7-img', image: block.settings.image, fallback: block.settings.image_fallback, alt: block.settings.title, cls: 'life', width: 800 -%}
            {%- endif -%}
            {%- if block.settings.hover_image != blank or block.settings.hover_image_fallback != blank -%}
              {%- render 'lv7-img', image: block.settings.hover_image, fallback: block.settings.hover_image_fallback, alt: block.settings.title, cls: 'alt', width: 800 -%}
            {%- endif -%}
          </div>
          <div class="body">
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.feature != blank -%}<p class="feat">{{ block.settings.feature }}</p>{%- endif -%}
            <div class="swatches" data-swatches>{%- if plist.size < 2 -%}<span class="sw-label">{{ block.settings.extra }}</span>{%- endif -%}</div>
            <div class="row"><span class="price" data-price>{{ p0.price | money }}</span>
              {%- assign r = p0.metafields.reviews.rating.value -%}
              {%- if r != blank -%}<span class="rating"><span class="stars">★★★★★</span>{{ r.rating | round: 1 }}</span>{%- endif -%}
            </div>
            <div data-action></div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Limmys best sellers",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The kit Limmys families come back for"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all best sellers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "textarea",
      "id": "swatches",
      "label": "Colour swatches",
      "default": "swim-vest-sunshine-blue-lim0021 | #7cc6f2, #f6c445 | vest_sunshine\nswim-vest-sunset-blue-m-lim0022 | #7cc6f2, #f28a3b | vest_sunset\nswim-vest-berry-pink-lim0023 | #e04f9b, #6b3fa0 | vest_berry\nswim-vest-pink-daisy-lim0024 | #f6b3cf, #6b3fa0 | vest_daisy\npremium-neoprene-swim-vest-pink-leopard | #f0408a, #6b5bd6 | vest_leopard\npremium-neoprene-swim-vest-for-girls | #ff6b7d, #1b2b55 | vest_blossom\npremium-neoprene-swim-vest-light-blue | #7cc6f2, #f6c445 | vest_azure\npremium-neoprene-swim-vest-for-boys-1 | #1f4fc4, #f6c445 | vest_royal\npremium-neoprene-swim-vest-for-boys | #1b2b55, #7cc6f2 | vest_navy\npremium-neoprene-swim-vest-pink-windmill | #d84bb2, #f6c445 | vest_windmill\npremium-neoprene-swim-vest-green | #8be33c, #1f4fc4 | vest_green\narm-bands-in-orange | #f7a21b, #2d6fd6\narm-bands-in-purple | #6b5bd6, #f58bb4\narm-bands-in-pink | #f58bb4\narm-bands-in-red | #e8392f, #f6c445\nchildrens-armbands-in-yellow-with-navy-accent | #f5d90a, #1b2b55\nchildrens-armbands-in-yellow-with-green-accent | #f5d90a, #8be33c\ngoggles-in-blue | #2d6fd6, #7cc6f2\ngoggles-in-pink | #f39bc8",
      "info": "One line per product: product-handle | swatch colour | built-in cut-out | card colour. Products not listed use their own photo and a grey dot."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "Product"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products (one per colour)",
          "limit": 12,
          "info": "First product shows first. Price, sizes and stock come from Shopify."
        },
        {
          "type": "text",
          "id": "feature",
          "label": "Short feature line"
        },
        {
          "type": "text",
          "id": "extra",
          "label": "Text under title when there is only one product",
          "info": "e.g. 6 colours"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "checkbox",
          "id": "badge_dark",
          "label": "Dark badge",
          "default": false
        },
        {
          "type": "color",
          "id": "tint",
          "label": "Card colour",
          "default": "#f2f5f8"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle photo (shown first)"
        },
        {
          "type": "text",
          "id": "image_fallback",
          "label": "Built-in image (used until you pick one)",
          "info": "Theme file name without the lv7- prefix. Leave as is."
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover photo (optional)"
        },
        {
          "type": "text",
          "id": "hover_image_fallback",
          "label": "Built-in image (used until you pick one)",
          "info": "Theme file name without the lv7- prefix. Leave as is."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Limmys best sellers"
    }
  ]
}
{% endschema %}
