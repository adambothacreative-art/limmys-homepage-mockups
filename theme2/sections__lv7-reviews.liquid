{% render 'lv7-head' %}
<div class="lv7">
<section class="s" style="padding-top:0">
  <div class="wrap">
    <div class="reviews">
      <div class="rev-sum">
        <span class="big">{{ section.settings.rating }}</span>
        <div><div class="stars">★★★★★</div><div style="color:var(--muted);font-size:15px">{{ section.settings.count_text }}</div></div>
        <h2 style="font-size:clamp(24px,2.4vw,30px);font-weight:700;margin-left:auto">{{ section.settings.heading }}</h2>
      </div>
      <div class="rev-grid">
        {%- for block in section.blocks -%}
          <div class="rev" {{ block.shopify_attributes }}>
            <div class="prod">{%- render 'lv7-img', image: block.settings.image, fallback: block.settings.image_fallback, alt: '', width: 120 -%}{{ block.settings.product }}</div>
            <span class="stars">★★★★★</span>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p><span class="who">{{ block.settings.author }}</span>
            {%- else -%}<div class="ph-line"></div><div class="ph-line"></div><div class="ph-line s"></div><span class="who">Add a verified review in the theme editor</span>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Limmys reviews",
  "settings": [
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Count line",
      "default": "from 31,067 verified reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by families worldwide"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "product",
          "label": "Product name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product photo"
        },
        {
          "type": "text",
          "id": "image_fallback",
          "label": "Built-in image (used until you pick one)",
          "info": "Theme file name without the lv7- prefix. Leave as is."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text (verified reviews only)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name (first name only)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Limmys reviews"
    }
  ]
}
{% endschema %}
